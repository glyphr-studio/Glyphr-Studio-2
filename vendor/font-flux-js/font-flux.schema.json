{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Font Flux JSON v1",
	"type": "object",
	"properties": { "_schemaVersion": { "const": 1 } },
	"anyOf": [
		{ "$ref": "#/$defs/simplified" },
		{ "$ref": "#/$defs/raw" },
		{ "$ref": "#/$defs/collection" }
	],
	"$defs": {
		"bytes": {
			"type": "array",
			"items": { "type": "integer", "minimum": 0, "maximum": 255 }
		},
		"exactInteger": {
			"type": "object",
			"required": ["$fontFluxBigInt"],
			"properties": {
				"$fontFluxBigInt": { "type": "string", "pattern": "^-?[0-9]+$" }
			},
			"additionalProperties": false
		},
		"point": {
			"type": "object",
			"properties": {
				"x": { "type": "number" },
				"y": { "type": "number" },
				"onCurve": { "type": "boolean" },
				"type": { "enum": ["M", "L", "Q", "C", "Z"] }
			}
		},
		"component": {
			"type": "object",
			"anyOf": [{ "required": ["glyphName"] }, { "required": ["glyphIndex"] }],
			"properties": {
				"glyphName": { "type": "string" },
				"glyphIndex": { "type": "integer", "minimum": 0, "maximum": 65534 }
			}
		},
		"glyph": {
			"type": "object",
			"properties": {
				"name": { "type": "string" },
				"unicode": {
					"type": ["integer", "null"],
					"minimum": 0,
					"maximum": 1114111,
					"not": { "minimum": 55296, "maximum": 57343, "type": "integer" }
				},
				"advanceWidth": { "type": "integer", "minimum": 0, "maximum": 65535 },
				"contours": {
					"type": "array",
					"items": { "type": "array", "items": { "$ref": "#/$defs/point" } }
				},
				"components": {
					"type": "array",
					"items": { "$ref": "#/$defs/component" }
				},
				"charString": { "$ref": "#/$defs/bytes" },
				"instructions": { "$ref": "#/$defs/bytes" }
			}
		},
		"tables": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"properties": { "_raw": { "$ref": "#/$defs/bytes" } }
			}
		},
		"simplified": {
			"type": "object",
			"required": ["font", "glyphs"],
			"properties": {
				"font": {
					"type": "object",
					"properties": {
						"unitsPerEm": { "type": "integer", "minimum": 16, "maximum": 16384 }
					}
				},
				"glyphs": {
					"type": "array",
					"minItems": 1,
					"maxItems": 65535,
					"items": { "$ref": "#/$defs/glyph" }
				},
				"tables": { "$ref": "#/$defs/tables" },
				"_woff": { "type": "object" },
				"axes": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["tag", "min", "default", "max"],
						"properties": {
							"tag": { "type": "string", "pattern": "^[ -~]{4}$" },
							"min": { "type": "number" },
							"default": { "type": "number" },
							"max": { "type": "number" }
						}
					}
				}
			}
		},
		"raw": {
			"not": { "required": ["font", "glyphs"] },
			"type": "object",
			"required": ["header", "tables"],
			"properties": {
				"header": { "type": "object" },
				"tables": { "$ref": "#/$defs/tables" }
			}
		},
		"collection": {
			"type": "object",
			"required": ["collection", "fonts"],
			"properties": {
				"collection": { "type": "object" },
				"fonts": {
					"type": "array",
					"minItems": 1,
					"items": {
						"anyOf": [
							{ "$ref": "#/$defs/simplified" },
							{ "$ref": "#/$defs/raw" }
						]
					}
				}
			}
		}
	}
}
